# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
VMLM_API_KEY=change-me-user-key
VMLM_ADMIN_API_KEY=change-me-admin-key
VMLM_LOG_LEVEL=INFO
# Development-only. Keep false anywhere other people can reach the API.
VMLM_FAILURE_INJECTION_ENABLED=false
